# Shared x86_64 diffconfig seed for ImmortalWrt master and openwrt-25.12.
# Derived with scripts/diffconfig.sh and validated with make defconfig on both.
# Full resolved configurations are published with the firmware releases.

# Target, image layout and recovery network
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_PREINIT_BROADCAST="192.168.50.255"
CONFIG_TARGET_PREINIT_IP="192.168.50.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# Build options and package features
# CONFIG_BPF_TOOLCHAIN_BUILD_LLVM is not set
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_BPF_TOOLCHAIN_HOST_PATH=""
CONFIG_BUILD_LOG=y
CONFIG_CCACHE=y
CONFIG_DAED_USE_KERNEL_BTF=y
CONFIG_DAE_USE_KERNEL_BTF=y
CONFIG_DEVEL=y
CONFIG_DWARVES=y
# CONFIG_FEED_video is not set
CONFIG_HTOP_LMSENSORS=y
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_CRYPTO_AUTH=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_HTTP2=y
CONFIG_LIBCURL_HTTP_AUTH=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_TFTP=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_LIBCURL_TLS_SRP=y
CONFIG_LIBCURL_UNIX_SOCKETS=y
# CONFIG_LIBCURL_ZLIB is not set
# CONFIG_LUA_ECO_MBEDTLS is not set
CONFIG_LUA_ECO_OPENSSL=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PCRE2_JIT_ENABLED=y
CONFIG_USE_LLVM_HOST=y
CONFIG_USE_MOLD=y

# Kernel / eBPF support required by dae and daed
CONFIG_KERNEL_BPF_EVENTS=y
# CONFIG_KERNEL_BPF_STREAM_PARSER is not set
# CONFIG_KERNEL_CRASH_DUMP is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
# CONFIG_KERNEL_F2FS_FS_POSIX_ACL is not set
# CONFIG_KERNEL_F2FS_FS_SECURITY is not set
CONFIG_KERNEL_FTRACE=y
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_KEXEC is not set
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y
# CONFIG_KERNEL_NETKIT is not set
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y

# Package selections (dependencies are resolved by make defconfig)
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_autocore=y
# CONFIG_PACKAGE_automount is not set
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
# CONFIG_PACKAGE_e2fsprogs is not set
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_flock=y
CONFIG_PACKAGE_glib2=y
CONFIG_PACKAGE_glib2-core=y
CONFIG_PACKAGE_glib2-gio=y
CONFIG_PACKAGE_glib2-gmodule=y
CONFIG_PACKAGE_glib2-gobject=y
CONFIG_PACKAGE_glib2-gthread=y
CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_i915-firmware-dmc is not set
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-arc4=y
