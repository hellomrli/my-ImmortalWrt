# response_ttl for the dae core that is embedded in daed (wing/dae-core).
#
# daed runs the dae data plane in-process (wing/dae/run.go builds
# control.NewControlPlane), and it shares the config schema handling with the
# standalone daemon. Its config/parser.go rejects unknown keys
# ("unexpected key: %v"), so while the daed backend is active a config rendered
# by luci-app-daede -- which writes response_ttl whenever the LuCI field is
# above zero -- would make daed refuse to start. The standalone dae package
# carries the same feature through .github/patches/010-dns-response-ttl.patch;
# this one covers the copy daed bundles.
#
# The core daed embeds is the revision dae-wing pins for wing/dae-core
# (daeuniverse/daed wing@dc503088 -> dae-core@85a1fc3c, April 2026), which is
# also why upstream's own 010-dns-response-ttl.patch applies here unchanged:
# upstream wrote it for exactly this revision. Two deltas were applied on top:
#
#   * control/dns_response_ttl_test.go: upstream's fixture builds a controller
#     through newTestDnsController(), which leaves log nil, and
#     NormalizeAndCacheDnsResp_ dereferences it in updateDnsCache -- the test
#     panicked instead of running. It now uses newScopedDnsController, and both
#     cases pass.
#   * config/response_ttl_test.go: new. Asserts that a config carrying
#     response_ttl parses and yields the value, which is the property this patch
#     exists for.
#
# Regenerate against a new core revision with:
#   tar --strip-components=1 -C a -xzf dae-core-<sha12>.tar.gz
#   cp -a a b && patch -p1 -d b < <upstream 010-dns-response-ttl.patch>
#   # adjust b/ as described above, then:
#   diff -ruN a b > dae-core-response-ttl.patch
#
# Verify with (dae_stub_ebpf avoids needing clang and the generated eBPF
# objects):
#   cd b && go build -tags dae_stub_ebpf ./config/... ./control/...
#   go test  -tags dae_stub_ebpf -count=1 ./config/ ./control/
# Verified that way against 85a1fc3c06e3765d143c868ba97ecd0be2aab4ea: build
# clean, both new tests pass, and the config and control suites are green.
diff -ruN a/cmd/reload_manager.go b/cmd/reload_manager.go
--- a/cmd/reload_manager.go	2026-04-22 16:54:08.000000000 +0800
+++ b/cmd/reload_manager.go	2026-09-20 13:35:01.367768130 +0800
@@ -423,5 +423,8 @@
 	b.WriteString("max_cache_size=")
 	b.WriteString(strconv.Itoa(dns.MaxCacheSize))
 	b.WriteByte(';')
+	b.WriteString("response_ttl=")
+	b.WriteString(strconv.Itoa(dns.ResponseTtl))
+	b.WriteByte(';')
 	return b.String()
 }
