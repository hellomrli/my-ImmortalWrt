+	BandwidthMaxTx      string        `mapstructure:"bandwidth_max_tx" default:"0"`
+	BandwidthMaxRx      string        `mapstructure:"bandwidth_max_rx" default:"0"`
+	UDPHopInterval      time.Duration `mapstructure:"udphop_interval" default:"30s"`
+	// BpfConnStateMapSize is accepted so a dae config written against dae's
+	// current schema parses (dae's example.dae ships the key). This revision
+	// sizes tcp_conn_state_map/udp_conn_state_map at compile time
