# Current dae config keys for the dae core that is embedded in daed
# (wing/dae-core).
#
# daed runs the dae data plane in-process and parses its stored global / dns /
# routing sections with the config package of the core it bundles here. That
# parser rejects unknown keys ("unexpected key: %v"), and the revision wing/
# pins (daeuniverse/daed wing@dc503088 -> dae-core@85a1fc3c, April 2026)
# predates four keys that dae's current schema -- and dae's own example.dae --
# carries:
#
#   global:  disable_thp, auto_sniff_punt, bpf_conn_state_map_size
#   dns:     optimistic_stale_reply_ttl
#
# One unknown key aborts the parse of the whole config, and daed treats a failed
# restore as "nothing was running": restoreRunningState() writes running=false
# and the data plane stays empty. That is what happened on 2026-09-20 -- the
# stored global section carried disable_thp:"true" (copied from dae's own
# /etc/dae/example.dae) and daed came up with "Routing match set len: 1/1024"
# and "Health check will only verify 1 outbounds ... [direct]", i.e. every
# routing rule, group and dns policy silently inert, while the dashboard still
# listed the config as selected. The log line was:
#
#   Failed to restore last running state: failed to parse "global":
#   unexpected key: disable_thp
#
# The fields below copy dae's current definitions (name, tag, default) so the
# same config text parses here. This revision has no implementation behind
# them, and both the struct comments and the desc entries the daed dashboard
# renders say so:
#
#   * disable_thp: upstream applies it in cmd/ (prctl PR_SET_THP_DISABLE), which
#     wing/ does not run -- the daed backend never applied it, not even on the
#     older build whose core happened to know the key.
#   * auto_sniff_punt: routing.InferSniffPunt arrived upstream after this
#     revision.
#   * bpf_conn_state_map_size: this revision sizes tcp_conn_state_map and
#     udp_conn_state_map at compile time (MAX_DST_MAPPING_NUM in
#     control/kern/tproxy.c).
#   * optimistic_stale_reply_ttl: this revision serves stale answers with the
#     TTL packed in the cached response.
#
# Accepting the keys is what keeps a config written for current dae from
# killing the daemon. The invariant behind it -- every key the dae package's
# example.dae ships must be accepted by the core daed builds -- is asserted by
# .github/scripts/check-dae-config-compat.py, so the next key dae adds fails
# the build in minutes instead of silently emptying the router's data plane.
#
# This patch is the second half of the dae-core series: it applies on top of
# dae-core-response-ttl.patch. It was generated against a tree that already had
# that patch applied, and its config.go hunks share context with it, so
# pin-daed-core.py applies them in that exact order.
#
# Regenerate against a new core revision with:
#   tar --strip-components=1 -C a -xzf dae-core-<sha12>.tar.gz
#   cp -a a b && patch -p1 -s -d b -i <path to dae-core-response-ttl.patch>
#   # edit b/ as described above, then:
#   diff -ruN a b > dae-core-config-compat.patch
#
# Verify with (dae_stub_ebpf avoids needing clang and the generated eBPF
# objects):
#   cd b && go build -tags dae_stub_ebpf ./config/... ./control/... ./cmd/...
#   go test  -tags dae_stub_ebpf -count=1 ./config/ ./control/ ./cmd/
# Verified that way against 85a1fc3c06e3765d143c868ba97ecd0be2aab4ea: build
# clean, config/control/cmd suites green. The two new config tests fail on the
# unpatched core with exactly the error the router logged
# ("failed to parse \"global\": unexpected key: disable_thp"), which is the
# regression they pin. TestLazyConnPool_ConcurrentCloseAndGet in ./control/ is
# timing-sensitive: it flaked once under load and passes on re-runs on both the
# patched and the unpatched tree.
diff -ruN a/cmd/run_shutdown_test.go b/cmd/run_shutdown_test.go
--- a/cmd/run_shutdown_test.go	2026-09-20 14:16:48.239819853 +0800
+++ b/cmd/run_shutdown_test.go	2026-09-20 14:18:58.220713867 +0800
@@ -517,6 +517,10 @@
 		"OptimisticCacheTtl": {},
 		"MaxCacheSize":       {},
 		"ResponseTtl":        {},
+		// Accepted for config compatibility with dae's current schema; this
+		// revision serves stale answers with their previously packed TTL, so
+		// the field carries no reload decision.
+		"OptimisticStaleReplyTtl": {},
 	}
 
 	dnsType := reflect.TypeOf(config.Dns{})
diff -ruN a/config/config_compat_keys_test.go b/config/config_compat_keys_test.go
--- a/config/config_compat_keys_test.go	1970-01-01 08:00:00.000000000 +0800
+++ b/config/config_compat_keys_test.go	2026-09-20 14:18:28.778509807 +0800
@@ -0,0 +1,104 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2022-2026, daeuniverse Organization <dae@v2raya.org>
+ */
+
+package config
+
+import (
+	"testing"
+
+	"github.com/daeuniverse/dae/pkg/config_parser"
+	"github.com/stretchr/testify/require"
+)
+
+// TestCurrentDaeSchemaKeysAreAccepted pins the failure this patch exists for.
+//
+// daed parses its stored global/dns/routing sections with this package, and
+// config/parser.go rejects unknown keys ("unexpected key: %v"). The revision
+// wing/ pins (85a1fc3c, April 2026) predates four keys that dae's current
+// schema -- and dae's own example.dae -- ships, so a stored config carrying any
+// of them failed to restore as a whole: on 2026-09-20 a single
+// disable_thp:"true" line made daed drop the running state it had on disk and
+// come up with an empty data plane (routing, groups and dns policy silently
+// reduced to "direct only").
+//
+// The quoting below matches what daed stores for a section saved by its own
+// dashboard, so the fixture is the shape that actually hit the parser.
+func TestCurrentDaeSchemaKeysAreAccepted(t *testing.T) {
+	sections, err := config_parser.Parse(`
+global {
+  tproxy_port:"12345"
+  log_level:"warn"
+  lan_interface:"br-lan"
+  wan_interface:"pppoe-wan"
+  dial_mode:"domain"
+  disable_waiting_network:"false"
+  disable_thp:"true"
+  sniffing_timeout:"200ms"
+  auto_sniff_punt:"true"
+  fallback_resolver:"8.8.8.8:53"
+  bpf_conn_state_map_size:"262144"
+}
+
+dns {
+  optimistic_stale_reply_ttl:"30"
+  upstream {
+    google: "8.8.8.8:53"
+  }
+  routing {
+    request {
+      fallback: google
+    }
+  }
+}
+
+routing {
+  fallback: direct
+}
+`)
+	require.NoError(t, err)
+
+	conf, err := New(sections)
+	require.NoError(t, err)
+	require.True(t, conf.Global.DisableTHP)
+	require.True(t, conf.Global.AutoSniffPunt)
+	require.Equal(t, uint32(262144), conf.Global.BpfConnStateMapSize)
+	require.Equal(t, 30, conf.Dns.OptimisticStaleReplyTtl)
+}
+
+// TestCurrentDaeSchemaKeysKeepTheirDefaults guards the other half of the
+// contract: a config that omits the keys must still parse and must expose the
+// defaults dae's schema documents, so the daed dashboard renders sane values
+// for them.
+func TestCurrentDaeSchemaKeysKeepTheirDefaults(t *testing.T) {
+	sections, err := config_parser.Parse(`
+global {
+  tproxy_port:"12345"
+  dial_mode:"domain"
+}
+
+dns {
+  upstream {
+    google: "8.8.8.8:53"
+  }
+  routing {
+    request {
+      fallback: google
+    }
+  }
+}
+
+routing {
+  fallback: direct
+}
+`)
+	require.NoError(t, err)
+
+	conf, err := New(sections)
+	require.NoError(t, err)
+	require.False(t, conf.Global.DisableTHP)
+	require.True(t, conf.Global.AutoSniffPunt)
+	require.Equal(t, uint32(262144), conf.Global.BpfConnStateMapSize)
+	require.Equal(t, 30, conf.Dns.OptimisticStaleReplyTtl)
+}
