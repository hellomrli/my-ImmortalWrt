+// currentResponseTtl returns the downstream TTL override, or 0 when the
+// running generation keeps upstream's TTLs.
+func (c *DnsController) currentResponseTtl() int {
+	rt := c.runtime()
+	if rt == nil {
+		return 0
+	}
+	return rt.responseTtl
+}
