diff -ruN a/control/dns_controller_cache.go b/control/dns_controller_cache.go
--- a/control/dns_controller_cache.go	2026-09-20 00:00:55.000000000 +0800
+++ b/control/dns_controller_cache.go	2026-09-20 02:26:00.924027905 +0800
@@ -1224,6 +1224,19 @@
 	// Freshness of dae-managed address answers is tracked by the entry deadline
 	// and the stale window, not by suppressing downstream caching.
 
+	// response_ttl pins the TTL advertised to downstream clients for address
+	// answers. Overriding here, after the entry lifetime was derived from the
+	// real record TTLs, keeps dae's own freshness bookkeeping intact: the
+	// packed entry carries the override and a cache hit replays its remaining
+	// part, so the TTL a client sees no longer depends on cache state.
+	// 0 keeps upstream's behaviour of forwarding the upstream TTL.
+	if responseTtl := c.currentResponseTtl(); responseTtl > 0 &&
+		(q.Qtype == dnsmessage.TypeA || q.Qtype == dnsmessage.TypeAAAA) {
+		for i := range msg.Answer {
+			msg.Answer[i].Header().Ttl = uint32(responseTtl)
+		}
+	}
+
 	// Update DnsCache.
 	return c.updateDnsCache(msg, responseCacheKey, ttl, &q)
 }
