+// TestControlPlaneRecorderFeedsPackageLevelSnapshot covers the accounting the
+// daed dashboard depends on: daed (wing/) reads runtimeOverview through the
+// package-level SnapshotRuntimeStats, while the data path meters bytes through
+// the plane-bound recorders, and newControlPlaneWithContextOptions always
+// installs a per-plane store. Without the mirror in recordUploadTraffic /
+// recordDownloadTraffic the package-level history stays empty and a busy router
+// reports 0 B/s and 0 B totals.
+func TestControlPlaneRecorderFeedsPackageLevelSnapshot(t *testing.T) {
+	resetRuntimeStatsForTest(t)
+
+	plane := &ControlPlane{runtimeStats: newRuntimeStats()}
+	plane.recordUploadTraffic(1200)
+	plane.recordDownloadTraffic(800)
+
+	snapshot := SnapshotRuntimeStats(3, 5, 60, 10)
+	if snapshot.UploadTotal != 1200 || snapshot.DownloadTotal != 800 {
+		t.Fatalf("package snapshot totals = (%d, %d), want (1200, 800)",
+			snapshot.UploadTotal, snapshot.DownloadTotal)
+	}
+	if snapshot.ActiveConnections != 3 || snapshot.UDPSessions != 5 {
+		t.Fatalf("package snapshot counters = (%d, %d), want (3, 5)",
+			snapshot.ActiveConnections, snapshot.UDPSessions)
+	}
+
+	// The plane keeps its own accounting...
+	planeSnapshot := plane.SnapshotRuntimeStats(60, 10)
+	if planeSnapshot.UploadTotal != 1200 || planeSnapshot.DownloadTotal != 800 {
+		t.Fatalf("plane totals = (%d, %d), want (1200, 800)",
+			planeSnapshot.UploadTotal, planeSnapshot.DownloadTotal)
+	}
+	// ...and every byte reaches the package-level history exactly once.
+	if got := globalRuntimeStats.uploadTotal.Load(); got != 1200 {
+		t.Fatalf("global upload total = %d, want 1200 (recorded exactly once)", got)
+	}
+	if got := globalRuntimeStats.downloadTotal.Load(); got != 800 {
+		t.Fatalf("global download total = %d, want 800 (recorded exactly once)", got)
+	}
+
+	// A plane that has no store of its own records straight into the
+	// package-level history, still without counting anything twice.
+	storeless := &ControlPlane{}
+	storeless.recordUploadTraffic(5)
+	if got := globalRuntimeStats.uploadTotal.Load(); got != 1205 {
+		t.Fatalf("global upload total after storeless record = %d, want 1205", got)
+	}
+}
