{
  "_comment": [
    "Single source of truth for which firmware branches this repository builds.",
    "Consumed by .github/workflows/openwrt-builder.yml, .github/workflows/update-checker.yml",
    "and .github/scripts/update-readme-build-table.py.  Add or remove a branch here",
    "and every consumer follows automatically."
  ],
  "targets": [
    {
      "label": "ImmortalWrt `master`（Honk）",
      "source": "immortalwrt",
      "branch": "master",
      "profile": "honk",
      "repo_url": "https://github.com/immortalwrt/immortalwrt",
      "config_file": "configs/honk.config",
      "diy_p1_sh": "diy-part1-honk.sh",
      "diy_p2_sh": "diy-part2-honk.sh"
    },
    {
      "label": "ImmortalWrt `iptv`（上游 master）",
      "source": "immortalwrt",
      "branch": "iptv",
      "upstream_branch": "master",
      "repo_url": "https://github.com/immortalwrt/immortalwrt",
      "config_file": "configs/iptv.config",
      "files_dir": "profiles/iptv/files",
      "diy_p1_sh": "diy-part1.sh",
      "diy_p2_sh": "diy-part2-iptv.sh"
    }
  ]
}
