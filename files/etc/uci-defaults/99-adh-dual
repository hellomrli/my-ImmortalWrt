#!/bin/sh
# Use the official adguardhome package only as the binary provider.
# On keep-config sysupgrade, old /etc/init.d/adh-* files may be restored from
# overlay and shadow the newer ROM copies.  Reinstall the dual-instance wrappers
# here so upgrades cannot keep stale paths such as /usr/bin/AdGuardHome/....

set -eu

ln -sf AdGuardHome /usr/bin/AdGuardHome-direct
ln -sf AdGuardHome /usr/bin/AdGuardHome-proxy

cat > /etc/init.d/adh-direct <<'EOS'
#!/bin/sh /etc/rc.common
USE_PROCD=1
START=94
STOP=10
BIN=/usr/bin/AdGuardHome-direct
CONF=/etc/AdGuardHome-direct.yaml
WORK=/var/lib/adguardhome-direct
start_service() {
  [ -x "$BIN" ] || return 1
  mkdir -p "$WORK"
  procd_open_instance
  procd_set_param command "$BIN" -c "$CONF" -w "$WORK" --web-addr 192.168.50.1:50080 --no-check-update --no-permcheck
  procd_set_param respawn 3600 5 5
  procd_set_param limits nofile="65535 65535"
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file "$CONF"
  procd_close_instance
}
reload_service() { stop; start; }
EOS

cat > /etc/init.d/adh-proxy <<'EOS'
#!/bin/sh /etc/rc.common
USE_PROCD=1
START=94
STOP=10
BIN=/usr/bin/AdGuardHome-proxy
CONF=/etc/AdGuardHome-proxy.yaml
WORK=/var/lib/adguardhome-proxy
start_service() {
  [ -x "$BIN" ] || return 1
  mkdir -p "$WORK"
  procd_open_instance
  procd_set_param command "$BIN" -c "$CONF" -w "$WORK" --web-addr 192.168.50.1:50081 --no-check-update --no-permcheck
  procd_set_param respawn 3600 5 5
  procd_set_param limits nofile="65535 65535"
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file "$CONF"
  procd_close_instance
}
reload_service() { stop; start; }
EOS

chmod 755 /etc/init.d/adh-direct /etc/init.d/adh-proxy

/etc/init.d/adguardhome stop >/dev/null 2>&1 || true
/etc/init.d/adguardhome disable >/dev/null 2>&1 || true
/etc/init.d/adh-direct enable >/dev/null 2>&1 || true
/etc/init.d/adh-proxy enable >/dev/null 2>&1 || true
/etc/init.d/adh-direct restart >/dev/null 2>&1 || true
/etc/init.d/adh-proxy restart >/dev/null 2>&1 || true
exit 0
