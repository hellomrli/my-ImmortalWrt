#!/bin/sh
# Use the official adguardhome package only as the binary provider.
# On keep-config sysupgrade, old /etc/init.d/adh-* files may be restored from
# overlay and shadow the newer ROM copies.  Reinstall the dual-instance wrappers
# here so upgrades cannot keep stale paths such as /usr/bin/AdGuardHome/....

set -eu

ln -sf AdGuardHome /usr/bin/AdGuardHome-direct
ln -sf AdGuardHome /usr/bin/AdGuardHome-proxy

adh_has_user() {
  awk '
    /^users:/ { in_users=1; next }
    in_users && /^[^[:space:]]/ { in_users=0 }
    in_users && /^[[:space:]]*-[[:space:]]+name:/ { found=1 }
    END { exit(found ? 0 : 1) }
  ' "$1"
}

secure_unauthenticated_web() {
  local conf="$1" address="$2"
  [ -f "$conf" ] || return 0
  if ! adh_has_user "$conf"; then
    sed -i "s#^  address:.*#  address: ${address}#" "$conf"
  fi
}

# Older images shipped users: [] while forcing the Web UI onto the LAN from the
# init command line.  On upgrade, close that exposure unless a real user exists.
secure_unauthenticated_web /etc/AdGuardHome-direct.yaml 127.0.0.1:50080
secure_unauthenticated_web /etc/AdGuardHome-proxy.yaml 127.0.0.1:50081

# The wrappers themselves ship in the read-only image as /etc/init.d/adh-*.
# Restore the ROM copy rather than repeating the script text here: a keep-config
# sysupgrade can carry an older overlay version that shadows the newer ROM one
# (that is what used to leave stale paths such as /usr/bin/AdGuardHome/...).
for svc in adh-direct adh-proxy; do
  if [ -f "/rom/etc/init.d/$svc" ]; then
    cp -f "/rom/etc/init.d/$svc" "/etc/init.d/$svc"
  fi
  if [ -f "/etc/init.d/$svc" ]; then
    chmod 755 "/etc/init.d/$svc"
  fi
done

/etc/init.d/adguardhome stop >/dev/null 2>&1 || true
/etc/init.d/adguardhome disable >/dev/null 2>&1 || true
/etc/init.d/adh-direct enable >/dev/null 2>&1 || true
/etc/init.d/adh-proxy enable >/dev/null 2>&1 || true
/etc/init.d/adh-direct restart >/dev/null 2>&1 || true
/etc/init.d/adh-proxy restart >/dev/null 2>&1 || true
exit 0
