#!/bin/sh /etc/rc.common
# Re-apply /etc/sysctl.d/99-performance.conf after connection tracking exists.
#
# kmod-nf-conntrack declares no AutoLoad, so nf_conntrack is not loaded until
# the firewall installs its rules at START=19.  /etc/init.d/sysctl runs at
# START=11 and uses `sysctl -e`, which silently ignores keys whose /proc entry
# does not exist yet -- so net.netfilter.* in that file would never take effect
# at boot, without any error to notice.
#
# Everything else in the file is already applied by then; re-applying it is
# harmless and keeps a single source of truth for the whole profile.

START=99

CONF=/etc/sysctl.d/99-performance.conf

start() {
	[ -f "$CONF" ] || return 0

	[ -e /proc/sys/net/netfilter/nf_conntrack_max ] || modprobe nf_conntrack 2>/dev/null || true
	modprobe sch_fq 2>/dev/null || true

	# Do not ignore missing keys or report success after a rejected setting.
	# sysctl continues through the file, so include its output when any fail.
	local output
	if output="$(sysctl -p "$CONF" 2>&1)"; then
		logger -t perf-tune "applied $CONF (cc=$(sysctl -n net.ipv4.tcp_congestion_control), qdisc=$(sysctl -n net.core.default_qdisc))"
	else
		logger -t perf-tune -p daemon.err "failed to apply $CONF: $output"
		return 1
	fi
}
